<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kevin.redeye.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/RedeyeHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.kevin.redeye.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.kevin.redeye</string>
	</array>
	<!-- Run at boot so a leftover disablesleep is reset, and restart after a crash for the same reason. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
